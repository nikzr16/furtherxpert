# Copy this file to .env and fill in real values for local/dev use.
# Never commit .env (see .gitignore). See docs/prd/furtherxpert-prd.md T8.

# --- Database ---
DATABASE_URL=postgresql+psycopg://app:changeme-dev-secret@db:5432/furtherxpert
POSTGRES_USER=app
POSTGRES_PASSWORD=changeme-dev-secret
POSTGRES_DB=furtherxpert

# --- Auth (JWT) ---
JWT_SECRET=changeme-dev-secret
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- AI ---
OPENAI_API_KEY=sk-changeme
OPENAI_MODEL=gpt-5

# --- CORS / client origin ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Client build-time var (Vite) ---
VITE_API_URL=http://localhost:8000
